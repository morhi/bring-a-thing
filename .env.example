APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PASSKEYS_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Production (https://bringathing.com, behind a TLS-terminating proxy)
# Values that must change for release; the defaults above are for local use.
# ---------------------------------------------------------------------------
# APP_ENV=production
# Proxies whose X-Forwarded-* headers are trusted. Default REMOTE_ADDR trusts the one proxy that connects to
# the app (right for a single load balancer in front). Behind a CDN plus load balancer chain, list explicit
# comma separated IPs/CIDRs. '*' and '**' trust every hop and let clients spoof their IP (throttling bypass): do not use them.
# TRUSTED_PROXIES=REMOTE_ADDR
# APP_DEBUG=false
# Passkey relying party id and origin derive from this URL (config/passkeys.php).
# APP_URL=https://bringathing.com
# Only for a host outside the APP_URL domain; subdomains of APP_URL (www) are not covered by it. Redirect
# www.bringathing.com to the apex at the proxy or DNS level: the session cookie is host-only and
# redirects are pinned to APP_URL.
# PASSKEYS_ALLOWED_HOSTS=
# Keep the long lifetime (minutes) so remembered devices stay logged in.
# SESSION_LIFETIME=525600
# Defaults to true in production; set explicitly only to override.
# SESSION_SECURE_COOKIE=true
# The log mailer never delivers: login links would not arrive. Use a real mailer.
# MAIL_MAILER=smtp
# MAIL_FROM_ADDRESS="hello@bringathing.com"
# Login mails are queued: with QUEUE_CONNECTION=database a worker must run
# permanently (php artisan queue:work), otherwise no mail is ever sent.
# QUEUE_CONNECTION=database
# LOG_LEVEL=warning
# Live updates (Reverb): the app reads these at runtime, the frontend build needs none (no VITE_REVERB_*).
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# Server side host, port and scheme of Reverb as the app reaches it.
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https
# Public host, port and scheme the browser connects with; set only when they differ from the above
# (for example Reverb reachable internally only). They default to the REVERB_HOST/PORT/SCHEME values.
# REVERB_CLIENT_HOST=
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https
# The Reverb server process needs to run permanently (php artisan reverb:start), listening on
# REVERB_SERVER_HOST (default 0.0.0.0) and REVERB_SERVER_PORT (default 8080) behind the proxy.
